    },
    "wordpress": {
      "enabled": true,
      "site": "oralcarehub.wordpress.com",
      "access_token": "YOUR_OAUTH2_ACCESS_TOKEN"
    }
  },
  "seo": {
    "default_tags": ["dental health", "oral care", "teeth", "dental tips", "oral hygiene"],
